# Server-only: local Docker Supabase Edge API (override with protected values in production).
SCHOOLDESK_API_BASE_URL=http://127.0.0.1:54321/functions/v1/api
# Synthetic School A fixture used by the local Docker stack.
SCHOOLDESK_PUBLIC_SCHOOL_ID=00000000-0000-4000-8000-000000000001
# Local development URL (override with the canonical deployment URL in production).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only Google Places credentials for the verified review summary.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Optional: Google Maps review URL used if Place Details is temporarily unavailable.
GOOGLE_REVIEWS_URL=
